# Vórtex Type — variáveis de ambiente
# Copie este arquivo para .env.local (no seu computador) e preencha. Na Vercel, cadastre as mesmas em
# Settings → Environment Variables. Nunca versione o .env.local (o .gitignore já ignora).

# --- Supabase (obrigatórias) -------------------------------------------------------------------------------
# Supabase → Project Settings → API Keys (aba "Legacy API keys") e Data API.
# Endereço do projeto Supabase.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave pública "anon" (pode ir pro navegador; o banco protege os dados com RLS).
NEXT_PUBLIC_SUPABASE_ANON_KEY=cole-aqui-a-chave-anon
# Chave secreta "service_role" (só no servidor; nunca compartilhe).
SUPABASE_SERVICE_ROLE_KEY=cole-aqui-a-chave-service-role

# --- Endereço do sistema (recomendada) -----------------------------------------------------------------------
# Endereço final do painel, sem barra no fim. Usado nos links da API, do MCP e dos webhooks e pra ligar os
# domínios próprios. Na sua máquina: http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://formularios.suaempresa.com.br

# --- Webhooks (obrigatória pra enviar webhooks) --------------------------------------------------------------
# Senha que autoriza a rota /api/cron/webhooks. Gere uma com: openssl rand -hex 24
CRON_SECRET=gere-um-valor-aleatorio

# --- Agendamento no fim do formulário (opcional) -------------------------------------------------------------
# Endereço do Vórtex Call (ou outro sistema de agenda com a mesma API). Vazio = aba Agendamento desligada.
# Vai no código do navegador: depois de trocar, publique de novo. Teste local: http://localhost:3999 (scripts/call-falso.mjs)
NEXT_PUBLIC_VORTEX_CALL_URL=

# --- Domínio próprio por formulário (opcional, as três juntas) -----------------------------------------------
# Token da Vercel (vercel.com/account/tokens). Sem as três, a aba Domínios fica desligada.
VERCEL_TOKEN=
# Id do projeto na Vercel (Project → Settings → General → Project ID).
VERCEL_PROJECT_ID=
# Id do time na Vercel (Team → Settings → General → Team ID).
VERCEL_TEAM_ID=

# --- Só pra testes na sua máquina (opcional) ---------------------------------------------------------------
# Porta do Vórtex Call de mentira (scripts/call-falso.mjs). Padrão 3999.
# PORTA=3999
